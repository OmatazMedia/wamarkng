# — Basic hardening + caching for the static WAMARK export —

<IfModule mod_rewrite.c>
  RewriteEngine On
  # /api/* is a PHP application — never treated as static pages.
  RewriteCond %{REQUEST_URI} !^/api/
  # Serve /page/ from /page/index.html (matches Next trailingSlash export)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
  # Extensionless app routes → their exported files (dashboard.html / login.html).
  RewriteRule ^(dashboard|login)/?$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

ErrorDocument 404 /404.html
